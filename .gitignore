# Generated by scripts/verify-browser.mjs on every run. The committed test
# bodies live in build/probe/*.js; the inlined HTML is a build product.
build/probe/*.inline.html

# Downloaded model fixtures (see docs/ASSET-CONTRACT.md — model files are never
# committed). Put your own models outside the repo and configure `modelDirs`.
# `scripts/make-vrma-fixtures.mjs` regenerates the generated ones and
# `node scripts/verify-model.mjs --fetch` fetches the PMD.
build/fixtures/

# The Chromium user-data-dir the probes borrow (vrm-probe/verify-browser pass
# `--user-data-dir=<repo>/build/browser-profile`): caches, crash dumps and the
# sync-conflict copies of them, ~130 MB, none of it this plugin's.
build/browser-profile/

# What the probes WRITE: screenshots, and the throwaway Electron profiles and
# settings-page DOM dumps/screenshots one QA round left behind. The committed
# probe bodies are build/probe/*.js; nothing here is read by a suite or cited
# by a doc.
build/probe-out/
build/probe/settings-qa-profile/
build/probe/settings-layout-qa-profile/
build/probe/*-preview.html
build/probe/settings-*-dom.html
build/probe/settings-*.png
build/*.png

# Build-only; `cd vendor && npm install` restores it. The compiled chunk in
# lib/client.vendor.js is committed instead, so the plugin runs with no toolchain.
vendor/node_modules/

node_modules/
*.log
.DS_Store
Thumbs.db

# Local backups a tool writes beside the file it rewrites (never shipped).
*.bak-local

