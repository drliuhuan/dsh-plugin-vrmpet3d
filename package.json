{
  "name": "dsh-plugin-vrmpet3d",
  "version": "0.1.2",
  "private": true,
  "description": "DeepSeek Harness 的 VRM 3D 桌宠：任务状态联动、独立悬浮窗、模型动作与 AI 碎碎念。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "desktop",
    "assets",
    "!assets/whale-tail.apng",
    "!assets/screenshots",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify-all.mjs",
    "verify:core": "node scripts/verify.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:load": "node scripts/check-plugin-load.mjs",
    "verify:profile": "node scripts/check-profile.mjs",
    "verify:vendor": "node scripts/vendor-build.mjs --check",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:whale": "node scripts/whale-asset.mjs --check",
    "pack:motions": "node scripts/compress-motions.mjs",
    "fetch:fixtures": "node scripts/verify-model.mjs --fetch",
    "fetch:whale": "node scripts/whale-asset.mjs",
    "vendor:build": "node scripts/vendor-build.mjs",
    "install:profile": "node scripts/install-desktop-plugin.mjs",
    "install:dev": "node scripts/make-dev-package.mjs && node scripts/install-desktop-plugin.mjs --package build/dev-package"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d.git"
  },
  "homepage": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d#readme",
  "bugs": {
    "url": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "vrm",
    "vrma",
    "threejs",
    "electron"
  ]
}
