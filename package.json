{
  "name": "dsh-plugin-vrmpet3d",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 的 VRM 3D 桌宠：任务状态联动、独立悬浮窗、模型动作与 AI 碎碎念。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "desktop",
    "assets",
    "!assets/whale-tail.apng",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "displayName": "桌宠 3D · VRM Pet 3D",
  "repository": {
    "type": "git",
    "url": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d.git"
  },
  "homepage": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d#readme",
  "bugs": {
    "url": "https://github.com/drliuhuan/dsh-plugin-vrmpet3d/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "vrm",
    "vrma",
    "threejs",
    "electron"
  ]
}
