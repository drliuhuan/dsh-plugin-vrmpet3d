{
  "name": "dsh-plugin-vrmpet3d",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D desktop pet for DeepSeek Harness: VRM models on a transparent WebGL layer, driven by live session status.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "desktop",
    "assets",
    "!assets/whale-tail.apng",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "displayName": "桌宠 3D · VRM Pet 3D"
}
